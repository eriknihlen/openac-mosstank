<?xml version="1.0" encoding="utf-8"?>
<!--
  The mana overlay: the Mag tab's Mana page's rows (the worn items, their
  state, mana and time left, not active first) in a small window of their
  own, shown while "Show mana overlay" is ticked on that page. It has the
  client's own title bar (titlebar="true"): drag it by the bar; the bar's
  close button hides it and unticks the setting. The client keeps where it
  was moved. It opens beside the main window, above the Inventory
  filters. w and h are the area under the bar: ten rows, the rest
  scrolled. The columns are the Mana page's, at its widths.
-->
<panel theme="plugin" x="1037" y="42" w="320" h="174" title="Mana"
       visible="{WindowAvailable}" resize="none" titlebar="true">
  <group x="0" y="0" w="320" h="174" visible="{MagOverlayShown}">
    <list x="0" y="2" w="320" h="170" rowheight="17"
          selected="{SelectedMagOverlayRow}" onchange="{SelectMagOverlayRow}"
          tooltip="The items you wear: mana now and at full, how long it lasts, and whether their spells are up (green: up, red: not up).">
      <column type="icon" width="16" iconkind="item" values="{MagOverlayIcons}"
              onclick="{SelectMagOverlayRow}" />
      <column type="text" width="148" items="{MagOverlayNames}"
              onclick="{SelectMagOverlayRow}" />
      <column type="icon" width="16" iconkind="did" values="{MagOverlayStates}"
              onclick="{SelectMagOverlayRow}" />
      <column type="text" width="78" items="{MagOverlayAmounts}"
              onclick="{SelectMagOverlayRow}" />
      <column type="text" width="44" items="{MagOverlayTimes}"
              onclick="{SelectMagOverlayRow}" />
    </list>
  </group>
</panel>
