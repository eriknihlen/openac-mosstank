<?xml version="1.0" encoding="utf-8"?>
<panel theme="plugin" x="253" y="325" w="650" h="500" title="MossTank Advanced Options"
       visible="{AdvancedOptionsVisible}" resizable="true" minw="650" minh="500">
  <label x="12" y="25" w="420" h="18" text="Search names and descriptions" color="theme:muted|#FFC7B98F" />
  <group x="12" y="46" w="548" h="24" background="theme:field|#FF0C0906" border="theme:border|#FF8C7B4E" anchor="left top right">
    <field x="1" y="1" w="546" h="22" text="{AdvancedOptionSearchText}"
           onchange="{SetAdvancedOptionSearchText}" maxlength="160" clearonsubmit="false"
           background="#00000000" anchor="left top right" />
  </group>
  <button x="570" y="46" w="68" h="24" text="Clear" onclick="{ClearAdvancedOptionSearch}" anchor="right top" />
  <label x="12" y="84" w="146" h="18" text="Categories" color="theme:muted|#FFC7B98F" />
  <label x="172" y="84" w="320" h="18" text="Option" color="theme:muted|#FFC7B98F" />
  <label x="515" y="84" w="120" h="18" text="Value" color="theme:muted|#FFC7B98F" anchor="right top" />
  <list x="12" y="108" w="146" h="202" rowheight="20" anchor="left top bottom"
        selected="{SelectedAdvancedOptionCategoryIndex}">
    <column type="check" width="20" values="{AdvancedOptionCategoryEnabled}" onchange="{ToggleAdvancedOptionCategoryAt}" />
    <column type="text" width="*" items="{AdvancedOptionCategoryNames}" onclick="{ToggleAdvancedOptionCategoryAt}" />
  </list>
  <list x="172" y="108" w="466" h="202" rowheight="22" anchor="left top right bottom"
        selected="{SelectedAdvancedOptionIndex}" onchange="{SelectAdvancedOption}">
    <column type="text" width="*" items="{AdvancedOptionNames}" onclick="{SelectAdvancedOption}" />
    <column type="text" width="123" items="{AdvancedOptionValueColumn}" onclick="{SelectAdvancedOption}" />
  </list>
  <label x="172" y="316" w="466" h="18" text="{AdvancedOptionResultCount}" color="theme:muted|#FFC7B98F" anchor="left right bottom" />
  <group x="12" y="342" w="626" h="64" background="theme:field|#FF0C0906" border="theme:border|#FF8C7B4E" anchor="left right bottom">
    <field x="1" y="1" w="624" h="62" text="{AdvancedOptionDescription}" color="theme:text|#FFE8DEC3"
           oneline="false" editable="false" maxlength="8192" background="#00000000" anchor="left top right" />
  </group>
  <group x="12" y="418" w="626" h="28" visible="{AdvancedOptionEditorVisible}" anchor="left right bottom">
    <group x="0" y="0" w="626" h="28" visible="{AdvancedOptionBooleanVisible}">
      <toggle x="0" y="0" w="350" h="24" text="{AdvancedOptionName}" checked="{AdvancedOptionBooleanValue}"
              onclick="{ToggleAdvancedOptionBoolean}" />
    </group>
    <group x="0" y="0" w="626" h="28" visible="{AdvancedOptionChoiceVisible}">
      <menu x="0" y="0" w="350" h="24" items="{AdvancedOptionChoices}" selected="{AdvancedOptionChoiceText}"
            onchange="{SelectAdvancedOptionChoiceText}" />
    </group>
    <group x="0" y="0" w="626" h="28" visible="{AdvancedOptionNumberVisible}">
      <group x="0" y="0" w="350" h="24" background="theme:field|#FF0C0906" border="theme:border|#FF8C7B4E">
        <field x="1" y="1" w="348" h="22" text="{AdvancedOptionValueDraft}"
               onchange="{SetAdvancedOptionValueDraft}" onsubmit="{SubmitAdvancedOption}"
               maxlength="160" clearonsubmit="false" background="#00000000" />
      </group>
      <button x="362" y="0" w="84" h="24" text="Apply" onclick="{ApplyAdvancedOption}" />
    </group>
  </group>
  <label x="12" y="462" w="626" h="22" text="{AdvancedOptionNotice}" color="theme:muted|#FFC7B98F" anchor="left right bottom" />
</panel>
