<?xml version="1.0" encoding="utf-8"?>
<!--
  A colour, edited with the controls the window already has. There is no
  colour control in the markup and this plugin does not get to add one to
  the client, so a colour is its four channels on sliders plus the same
  #AARRGGBB text the rest of the window is written in, either of which
  drives the other. The swatch beside the target line is a group whose
  background is bound to the draft, so what is being edited is seen as well
  as read; its alpha is the draft's alpha, over the window's own ground.
-->
<panel theme="plugin" x="253" y="405" w="268" h="182" title="MossTank Colour"
       visible="{UbColorVisible}" resize="none">
  <label x="4" y="22" w="60" h="16" text="Alpha" color="theme:text|#FFE8DEC3" />
  <slider x="68" y="22" w="152" h="16" min="0" max="255"
          value="{UbColorAlpha}" onchange="{SetUbColorAlpha}"
          tooltip="How solid the colour is, from 0 to 255." />
  <label x="226" y="22" w="38" h="16" text="{UbColorAlphaText}" color="theme:muted|#FFC7B98F" />

  <label x="4" y="40" w="60" h="16" text="Red" color="theme:text|#FFE8DEC3" />
  <slider x="68" y="40" w="152" h="16" min="0" max="255"
          value="{UbColorRed}" onchange="{SetUbColorRed}"
          tooltip="How much red, from 0 to 255." />
  <label x="226" y="40" w="38" h="16" text="{UbColorRedText}" color="theme:muted|#FFC7B98F" />

  <label x="4" y="58" w="60" h="16" text="Green" color="theme:text|#FFE8DEC3" />
  <slider x="68" y="58" w="152" h="16" min="0" max="255"
          value="{UbColorGreen}" onchange="{SetUbColorGreen}"
          tooltip="How much green, from 0 to 255." />
  <label x="226" y="58" w="38" h="16" text="{UbColorGreenText}" color="theme:muted|#FFC7B98F" />

  <label x="4" y="76" w="60" h="16" text="Blue" color="theme:text|#FFE8DEC3" />
  <slider x="68" y="76" w="152" h="16" min="0" max="255"
          value="{UbColorBlue}" onchange="{SetUbColorBlue}"
          tooltip="How much blue, from 0 to 255." />
  <label x="226" y="76" w="38" h="16" text="{UbColorBlueText}" color="theme:muted|#FFC7B98F" />

  <label x="4" y="100" w="40" h="16" text="Hex:" color="theme:text|#FFE8DEC3" />
  <group x="48" y="98" w="216" h="18" background="theme:field|#FF0C0906" border="theme:border|#FF8C7B4E">
    <field x="1" y="1" w="214" h="16" text="{UbColorHex}"
           onchange="{SetUbColorHex}" onsubmit="{SubmitUbColorHex}"
           maxlength="9" clearonsubmit="false" background="#00000000"
           color="theme:text|#FFE8DEC3"
           tooltip="The colour as #AARRGGBB; the sliders follow it." />
  </group>

  <label x="4" y="122" w="200" h="16" text="{UbColorTarget}" color="theme:muted|#FFC7B98F" />
  <group x="208" y="120" w="56" h="20" background="{UbColorSwatch}" border="theme:border|#FF8C7B4E"
         tooltip="The colour being edited, as it will draw." />

  <button x="4" y="146" w="80" h="20" text="Save" onclick="{ApplyUbColor}"
          tooltip="Save this colour into the setting and close." />
  <button x="90" y="146" w="80" h="20" text="Cancel" onclick="{HideUbColorEditor}"
          tooltip="Close without changing the setting." />
  <button x="176" y="146" w="88" h="20" text="Default"
          onclick="{ResetUbColorToDefault}"
          tooltip="Load the shipped colour for this setting." />
</panel>
