               tooltip="Only items with a spell whose name contains this, case ignored (any spell, any tier)." />
      </group>
      <list x="4" y="26" w="452" h="324" rowheight="17" header="true"
            selected="{SelectedMagFilterCantripRow}" onchange="{SelectMagFilterCantripRow}"
            tooltip="Check the cantrips the item must all have (a click on the name checks it too). Each is matched at its tier or better: click the tier to change it.">
        <column type="checkbox" width="20" values="{MagFilterCantripChecks}"
                onchange="{ToggleMagFilterCantrip}" />
        <column type="text" width="86" header="Group" items="{MagFilterCantripGroups}"
                onclick="{ToggleMagFilterCantrip}" />
        <column type="text" width="250" header="Cantrip" items="{MagFilterCantripNames}"
                onclick="{ToggleMagFilterCantrip}" />
        <column type="button" width="96" header="Tier" items="{MagFilterCantripTiers}"
                onclick="{CycleMagFilterCantripTier}" />
      </list>
      <label x="4" y="356" w="90" h="16" text="{MagFilterCantripCheckedText}"
             color="theme:muted|#FFC7B98F" tooltip="How many cantrips are checked." />
      <checkbox x="100" y="355" w="120" h="18" text="Checked only"
                checked="{MagFilterCantripCheckedOnly}" onchange="{SetMagFilterCantripCheckedOnly}"
