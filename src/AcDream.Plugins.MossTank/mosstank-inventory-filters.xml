                onchange="{SetMagFilterCd2}" color="theme:text|#FFE8DEC3"
                tooltip="Armor pieces may have crit damage tier 2 (all or none checked: no filter)." />
      <button x="392" y="354" w="64" h="20" text="Reset" onclick="{ResetMagFiltersTab}"
              tooltip="Clear this tab's filters; the other tabs keep theirs." />
    </group>

    <!-- Set: the sets among the characters searched, with how many items
         of each they hold. -->
    <group x="0" y="22" w="460" h="378" visible="{MagFiltersSetVisible}">
      <label x="4" y="4" w="34" h="16" text="Find:" color="theme:text|#FFE8DEC3" />
      <group x="40" y="2" w="150" h="18" background="theme:field|#FF0C0906" border="theme:border|#FF8C7B4E">
        <field x="1" y="1" w="148" h="16" text="{MagFilterSetFind}" onchange="{SetMagFilterSetFind}"
               maxlength="40" clearonsubmit="false" background="#00000000" color="theme:text|#FFE8DEC3"
               tooltip="Only the sets whose name contains this, case ignored." />
      </group>
      <list x="4" y="26" w="452" h="324" rowheight="17" header="true"
            selected="{SelectedMagFilterSetRow}" onchange="{SelectMagFilterSetRow}"
            tooltip="Only items of the set clicked; Any set for every item.">
        <column type="text" width="392" header="Set" items="{MagFilterSetNames}"
                onclick="{SelectMagFilterSetRow}" />
        <column type="text" width="60" align="right" header="Items" items="{MagFilterSetCounts}"
                onclick="{SelectMagFilterSetRow}" />
      </list>
      <button x="392" y="354" w="64" h="20" text="Reset" onclick="{ResetMagFiltersTab}"
              tooltip="Clear this tab's filters; the other tabs keep theirs." />
    </group>

    <!-- Reqs &amp; value: blank, no filter. -->
    <group x="0" y="22" w="460" h="378" visible="{MagFiltersReqsVisible}">
      <label x="4" y="6" w="96" h="16" text="Wield level ≤" color="theme:text|#FFE8DEC3" />
      <group x="104" y="4" w="110" h="18" background="theme:field|#FF0C0906" border="theme:border|#FF8C7B4E">
        <field x="1" y="1" w="108" h="16" text="{MagFilterReqMaxWield}" onchange="{SetMagFilterReqMaxWield}"
               maxlength="12" clearonsubmit="false" background="#00000000" color="theme:text|#FFE8DEC3"
               tooltip="The highest character level an item may need to be wielded; an item that needs none passes. Blank: no filter." />
      </group>
      <label x="4" y="28" w="96" h="16" text="Value ≥" color="theme:text|#FFE8DEC3" />
      <group x="104" y="26" w="110" h="18" background="theme:field|#FF0C0906" border="theme:border|#FF8C7B4E">
        <field x="1" y="1" w="108" h="16" text="{MagFilterReqMinValue}" onchange="{SetMagFilterReqMinValue}"
               maxlength="12" clearonsubmit="false" background="#00000000" color="theme:text|#FFE8DEC3"
               tooltip="The lowest value. Blank: no filter." />
      </group>
      <label x="4" y="50" w="96" h="16" text="Workmanship ≥" color="theme:text|#FFE8DEC3" />
      <group x="104" y="48" w="110" h="18" background="theme:field|#FF0C0906" border="theme:border|#FF8C7B4E">
        <field x="1" y="1" w="108" h="16" text="{MagFilterReqMinWorkmanship}" onchange="{SetMagFilterReqMinWorkmanship}"
               maxlength="12" clearonsubmit="false" background="#00000000" color="theme:text|#FFE8DEC3"
               tooltip="The lowest workmanship. Blank: no filter." />
      </group>
      <label x="4" y="72" w="96" h="16" text="Burden ≤" color="theme:text|#FFE8DEC3" />
      <group x="104" y="70" w="110" h="18" background="theme:field|#FF0C0906" border="theme:border|#FF8C7B4E">
        <field x="1" y="1" w="108" h="16" text="{MagFilterReqMaxBurden}" onchange="{SetMagFilterReqMaxBurden}"
               maxlength="12" clearonsubmit="false" background="#00000000" color="theme:text|#FFE8DEC3"
               tooltip="The highest burden. Blank: no filter." />
      </group>
      <button x="392" y="354" w="64" h="20" text="Reset" onclick="{ResetMagFiltersTab}"
              tooltip="Clear this tab's filters; the other tabs keep theirs." />
    </group>

    <!-- Characters: every character with a saved inventory on this server,
         the logged-in one first. -->
    <group x="0" y="22" w="460" h="378" visible="{MagFiltersCharactersVisible}">
      <list x="4" y="4" w="452" h="344" rowheight="17"
            selected="{SelectedMagFilterCharacterRow}" onchange="{SelectMagFilterCharacterRow}"
            tooltip="The characters whose items are searched.">
        <column type="checkbox" width="20" values="{MagFilterCharacterChecks}"
                onchange="{ToggleMagFilterCharacter}" />
        <column type="text" width="432" items="{MagFilterCharacterNames}"
                onclick="{ToggleMagFilterCharacter}" />
      </list>
      <button x="4" y="354" w="64" h="20" text="All" onclick="{SelectAllMagFilterCharacters}"
              tooltip="Search every character." />
      <button x="72" y="354" w="64" h="20" text="None" onclick="{SelectNoMagFilterCharacters}"
              tooltip="Search no character (then check the ones to search)." />
      <button x="392" y="354" w="64" h="20" text="Reset" onclick="{ResetMagFiltersTab}"
              tooltip="Clear this tab's filters; the other tabs keep theirs." />
    </group>
  </group>
</panel>
