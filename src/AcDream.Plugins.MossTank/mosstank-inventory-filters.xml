                tooltip="Items worn here (any slot checked; none: every slot)." />
      <checkbox x="150" y="126" w="100" h="18" text="Bracelet" checked="{MagFilterSlotBracelet}"
                onchange="{SetMagFilterSlotBracelet}" color="theme:text|#FFE8DEC3"
                tooltip="Items worn here (any slot checked; none: every slot)." />
      <checkbox x="252" y="126" w="100" h="18" text="Neck" checked="{MagFilterSlotNeck}"
                onchange="{SetMagFilterSlotNeck}" color="theme:text|#FFE8DEC3"
                tooltip="Items worn here (any slot checked; none: every slot)." />
      <checkbox x="354" y="126" w="100" h="18" text="Trinket" checked="{MagFilterSlotTrinket}"
                onchange="{SetMagFilterSlotTrinket}" color="theme:text|#FFE8DEC3"
                tooltip="Items worn here (any slot checked; none: every slot)." />
      <checkbox x="48" y="146" w="100" h="18" text="Cloak" checked="{MagFilterSlotCloak}"
                onchange="{SetMagFilterSlotCloak}" color="theme:text|#FFE8DEC3"
                tooltip="Items worn here (any slot checked; none: every slot)." />
      <checkbox x="150" y="146" w="100" h="18" text="Head" checked="{MagFilterSlotHead}"
                onchange="{SetMagFilterSlotHead}" color="theme:text|#FFE8DEC3"
                tooltip="Items worn here (any slot checked; none: every slot)." />
      <checkbox x="252" y="146" w="100" h="18" text="Chest" checked="{MagFilterSlotChest}"
                onchange="{SetMagFilterSlotChest}" color="theme:text|#FFE8DEC3"
                tooltip="Items worn here (any slot checked; none: every slot)." />
      <checkbox x="354" y="146" w="100" h="18" text="Abdomen" checked="{MagFilterSlotAbdomen}"
                onchange="{SetMagFilterSlotAbdomen}" color="theme:text|#FFE8DEC3"
                tooltip="Items worn here (any slot checked; none: every slot)." />
      <checkbox x="48" y="166" w="100" h="18" text="Upper Arms" checked="{MagFilterSlotUpperArms}"
                onchange="{SetMagFilterSlotUpperArms}" color="theme:text|#FFE8DEC3"
                tooltip="Items worn here (any slot checked; none: every slot)." />
      <checkbox x="150" y="166" w="100" h="18" text="Lower Arms" checked="{MagFilterSlotLowerArms}"
                onchange="{SetMagFilterSlotLowerArms}" color="theme:text|#FFE8DEC3"
                tooltip="Items worn here (any slot checked; none: every slot)." />
      <checkbox x="252" y="166" w="100" h="18" text="Hands" checked="{MagFilterSlotHands}"
                onchange="{SetMagFilterSlotHands}" color="theme:text|#FFE8DEC3"
                tooltip="Items worn here (any slot checked; none: every slot)." />
      <checkbox x="354" y="166" w="100" h="18" text="Upper Legs" checked="{MagFilterSlotUpperLegs}"
                onchange="{SetMagFilterSlotUpperLegs}" color="theme:text|#FFE8DEC3"
                tooltip="Items worn here (any slot checked; none: every slot)." />
      <checkbox x="48" y="186" w="100" h="18" text="Lower Legs" checked="{MagFilterSlotLowerLegs}"
