<?xml version="1.0" encoding="utf-8"?>
<!--
  The Inventory filters window: the filters of the owner's MosswartOverlord
  inventory search, opened by the Inventory window's Filters... button. Six
  tabs; every filter set is ANDed with the others and with the Inventory
  window's search text, and the rows follow 0.4 s after the last change.
  The filters live for the client session.

  Everything sits in one group shown while the client shows the window
  ({MagFiltersShown}), each tab's page in its own group: the lists are
  worked out and pushed only while their page is shown. Each page's Reset
  clears that tab's filters only; the Inventory window's Clear clears them
  all. It opens to the right of the Inventory window, not over its rows.
-->
<panel theme="plugin" x="1037" y="325" w="460" h="420" title="MossTank Inventory Filters"
       visible="{WindowAvailable}" resize="none">
  <group x="0" y="20" w="460" h="400" visible="{MagFiltersShown}">
    <tab x="4" y="2" w="38" h="18" text="Item"
         selected="{MagFiltersItemSelected}" onclick="{ShowMagFiltersItem}"
         tooltip="The item: worn or not, bonded, attuned, rare, its type and slot." />
    <tab x="42" y="2" w="56" h="18" text="Cantrips"
         selected="{MagFiltersCantripsSelected}" onclick="{ShowMagFiltersCantrips}"
         tooltip="The cantrips the item must all have, each at its tier or better, and a spell name." />
    <tab x="98" y="2" w="52" h="18" text="Ratings"
         selected="{MagFiltersRatingsSelected}" onclick="{ShowMagFiltersRatings}"
         tooltip="The lowest ratings, and the crit damage armor may have." />
    <tab x="150" y="2" w="34" h="18" text="Set"
         selected="{MagFiltersSetSelected}" onclick="{ShowMagFiltersSet}"
         tooltip="The equipment set." />
    <tab x="184" y="2" w="84" h="18" text="Reqs &amp; value"
         selected="{MagFiltersReqsSelected}" onclick="{ShowMagFiltersReqs}"
         tooltip="The highest wield level and burden, the lowest value and workmanship." />
    <tab x="268" y="2" w="68" h="18" text="Characters"
         selected="{MagFiltersCharactersSelected}" onclick="{ShowMagFiltersCharacters}"
         tooltip="The characters searched." />

    <!-- Item. -->
    <group x="0" y="22" w="460" h="378" visible="{MagFiltersItemVisible}">
      <label x="4" y="6" w="40" h="16" text="Worn:" color="theme:text|#FFE8DEC3" />
      <radio x="48" y="4" w="260" h="20" items="Any|Equipped|Not equipped"
             selected="{MagFilterEquipped}" onchange="{SetMagFilterEquipped}"
             orientation="horizontal" style="segmented"
             tooltip="Any item, only the ones worn or wielded, or only the others." />
      <checkbox x="48" y="30" w="80" h="18" text="Bonded" checked="{MagFilterBonded}"
                onchange="{SetMagFilterBonded}" color="theme:text|#FFE8DEC3" tooltip="Only bonded items." />
      <checkbox x="136" y="30" w="80" h="18" text="Attuned" checked="{MagFilterAttuned}"
                onchange="{SetMagFilterAttuned}" color="theme:text|#FFE8DEC3" tooltip="Only attuned items." />
      <checkbox x="224" y="30" w="80" h="18" text="Rare" checked="{MagFilterRare}"
                onchange="{SetMagFilterRare}" color="theme:text|#FFE8DEC3" tooltip="Only rares." />
      <label x="4" y="58" w="40" h="16" text="Type:" color="theme:text|#FFE8DEC3" />
      <radio x="48" y="56" w="408" h="20" items="All|Armor|Jewelry|Weapons|Clothing|Shirts|Pants"
             selected="{MagFilterType}" onchange="{SetMagFilterType}"
             orientation="horizontal" style="segmented"
             tooltip="Only items of this type: armor with an armor level, jewelry, weapons and casters, clothing, shirts, pants." />
      <group x="48" y="80" w="408" h="38" visible="{MagFilterWeaponKindsVisible}">
        <checkbox x="0" y="0" w="100" h="18" text="Heavy" checked="{MagFilterWeaponHeavy}"
                  onchange="{SetMagFilterWeaponHeavy}" color="theme:text|#FFE8DEC3"
                  tooltip="Weapons of this kind (any kind checked; none: every weapon)." />
        <checkbox x="102" y="0" w="100" h="18" text="Light" checked="{MagFilterWeaponLight}"
                  onchange="{SetMagFilterWeaponLight}" color="theme:text|#FFE8DEC3"
                  tooltip="Weapons of this kind (any kind checked; none: every weapon)." />
        <checkbox x="204" y="0" w="100" h="18" text="Finesse" checked="{MagFilterWeaponFinesse}"
                  onchange="{SetMagFilterWeaponFinesse}" color="theme:text|#FFE8DEC3"
                  tooltip="Weapons of this kind (any kind checked; none: every weapon)." />
        <checkbox x="306" y="0" w="100" h="18" text="Two-handed" checked="{MagFilterWeaponTwoHanded}"
                  onchange="{SetMagFilterWeaponTwoHanded}" color="theme:text|#FFE8DEC3"
                  tooltip="Weapons of this kind (any kind checked; none: every weapon)." />
        <checkbox x="0" y="20" w="100" h="18" text="Missile" checked="{MagFilterWeaponMissile}"
                  onchange="{SetMagFilterWeaponMissile}" color="theme:text|#FFE8DEC3"
                  tooltip="Weapons of this kind (any kind checked; none: every weapon)." />
        <checkbox x="102" y="20" w="100" h="18" text="War Magic" checked="{MagFilterWeaponWar}"
                  onchange="{SetMagFilterWeaponWar}" color="theme:text|#FFE8DEC3"
                  tooltip="Weapons of this kind (any kind checked; none: every weapon)." />
        <checkbox x="204" y="20" w="100" h="18" text="Void Magic" checked="{MagFilterWeaponVoid}"
