      <checkbox x="150" y="186" w="100" h="18" text="Feet" checked="{MagFilterSlotFeet}"
                onchange="{SetMagFilterSlotFeet}" color="theme:text|#FFE8DEC3"
                tooltip="Items worn here (any slot checked; none: every slot)." />
      <checkbox x="252" y="186" w="100" h="18" text="Shield" checked="{MagFilterSlotShield}"
                onchange="{SetMagFilterSlotShield}" color="theme:text|#FFE8DEC3"
                tooltip="Items worn here (any slot checked; none: every slot)." />
      <button x="392" y="354" w="64" h="20" text="Reset" onclick="{ResetMagFiltersTab}"
              tooltip="Clear this tab's filters; the other tabs keep theirs." />
    </group>

    <!-- Cantrips: each row's box puts the cantrip in the filter at the
         row's tier; a click on the tier steps it (Minor, Major, Epic,
         Legendary, round again). A list cell cannot be a menu, so the
         tier is a button that cycles. -->
    <group x="0" y="22" w="460" h="378" visible="{MagFiltersCantripsVisible}">
      <label x="4" y="4" w="34" h="16" text="Find:" color="theme:text|#FFE8DEC3" />
      <group x="40" y="2" w="150" h="18" background="theme:field|#FF0C0906" border="theme:border|#FF8C7B4E">
        <field x="1" y="1" w="148" h="16" text="{MagFilterCantripFind}" onchange="{SetMagFilterCantripFind}"
               maxlength="40" clearonsubmit="false" background="#00000000" color="theme:text|#FFE8DEC3"
               tooltip="Only the cantrips whose name contains this, case ignored." />
      </group>
      <label x="200" y="4" w="110" h="16" text="Spell name contains:" color="theme:text|#FFE8DEC3" />
      <group x="312" y="2" w="144" h="18" background="theme:field|#FF0C0906" border="theme:border|#FF8C7B4E">
        <field x="1" y="1" w="142" h="16" text="{MagFilterSpellContains}" onchange="{SetMagFilterSpellContains}"
