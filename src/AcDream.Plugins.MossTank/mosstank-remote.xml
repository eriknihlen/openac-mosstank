<?xml version="1.0" encoding="utf-8"?>
<panel theme="plugin" x="28" y="325" w="154" h="174" title="MossTank"
       visible="{WindowAvailable}" resize="none">
  <button x="128" y="3" w="18" h="17" text="M" anchor="right top" onclick="{ShowMainWindow}"
          tooltip="Restore the main MossTank window" />
  <toggle x="6" y="24" w="64" h="18" text="On" checked="{CombatMacroRunning}" onclick="{ToggleCombat}"
          tooltip="Start or pause the macro" />
  <toggle x="6" y="44" w="62" h="18" text="Buff" checked="{BuffingEnabled}" onclick="{ToggleBuffing}" />
  <toggle x="70" y="44" w="78" h="18" text="Combat" checked="{CombatEnabled}" onclick="{ToggleCombatEnabled}" />
  <toggle x="6" y="64" w="82" h="18" text="Navigate" checked="{NavigationEnabled}" onclick="{ToggleNavigation}" />
  <toggle x="92" y="64" w="56" h="18" text="Loot" checked="{LootEnabled}" onclick="{ToggleLooting}" />
  <toggle x="76" y="24" w="72" h="18" text="Meta" checked="{MetaEnabled}" onclick="{ToggleMeta}" />
  <toggle x="6" y="84" w="142" h="18" text="Follow corners" checked="{FollowAroundCornersEnabled}" onclick="{ToggleFollowAroundCorners}"
          tooltip="FollowAroundCorners" />
  <toggle x="6" y="104" w="142" h="18" text="Target lock" checked="{TargetLockEnabled}" onclick="{ToggleTargetLock}"
          tooltip="Prefer the selected monster among otherwise comparable targets; priority and debuff needs still apply" />
  <button x="6" y="140" w="44" h="24" text="F" onclick="{ForceBuff}" tooltip="Force Buff" />
  <button x="55" y="140" w="44" h="24" text="CF" onclick="{CancelForceBuff}" tooltip="Cancel Force Buff" />
  <button x="104" y="140" w="44" h="24" text="FC" onclick="{RemoteFollowSelected}"
          tooltip="Follow the selected player using the separate follow route. Preserves your navigation file and all macro switches." />
</panel>
