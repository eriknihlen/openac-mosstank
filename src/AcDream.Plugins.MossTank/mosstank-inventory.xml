<?xml version="1.0" encoding="utf-8"?>
<!--
  The Inventory window: Mag-Tools' inventory search (its Tools, Inventory
  page) over every character the inventory logger has saved on this server,
  the logged-in character's rows live. A pattern to search for, a filter by
  character and by kind of object, the rows found, and the clicked row's
  full item text below them. It has its own button on the dock; the Mag
  tab's Inventory button opens it too.

  Everything sits in one group shown while the client shows the window
  ({MagInventoryShown}): its rows are worked out and pushed only then.
-->
<panel theme="plugin" x="253" y="405" w="640" h="480" title="MossTank Inventory"
       visible="{WindowAvailable}" resize="none">
  <group x="0" y="20" w="640" h="460" visible="{MagInventoryShown}">
    <label x="4" y="4" w="50" h="16" text="Search:" color="theme:text|#FFE8DEC3" />
    <group x="56" y="2" w="580" h="18" background="theme:field|#FF0C0906" border="theme:border|#FF8C7B4E">
      <field x="1" y="1" w="578" h="16" text="{MagInventorySearchText}"
             onchange="{SetMagInventorySearchText}"
             maxlength="200" clearonsubmit="false" background="#00000000"
             color="theme:text|#FFE8DEC3"
             tooltip="A .NET regular expression, matched against each item's full text, case ignored; empty finds everything." />
    </group>

    <label x="4" y="26" w="66" h="16" text="Character:" color="theme:text|#FFE8DEC3" />
    <menu x="72" y="24" w="160" h="20" items="{MagInventoryCharacters}"
          selected="{SelectedMagInventoryCharacter}" onchange="{SelectMagInventoryCharacter}"
          rows="10" tooltip="Only this character's items." />
    <label x="240" y="26" w="40" h="16" text="Class:" color="theme:text|#FFE8DEC3" />
    <menu x="282" y="24" w="160" h="20" items="{MagInventoryClasses}"
          selected="{SelectedMagInventoryClass}" onchange="{SelectMagInventoryClass}"
          rows="10" tooltip="Only this kind of object." />
    <label x="450" y="26" w="186" h="16" text="{MagInventoryStatus}" color="theme:muted|#FFC7B98F"
           tooltip="How many items are shown, or what is still being read or searched." />

    <!-- The list draws its own headings, each over its column and aligned
         as its cells. The last column always takes the room the others
         leave, so Name has a fixed width (the list's 632 less the other
         columns) and Where keeps its 90. -->
    <list x="4" y="50" w="632" h="318" rowheight="17" header="true"
          selected="{SelectedMagInventoryRow}" onchange="{SelectMagInventoryRow}"
          tooltip="The items found. Click one to see its full text below; your own item is selected, its side pack opened.">
      <column type="icon" width="20" iconkind="did" values="{MagInventoryRowIcons}"
              onclick="{SelectMagInventoryRow}" />
      <column type="text" width="110" header="Character" items="{MagInventoryRowCharacters}"
              onclick="{SelectMagInventoryRow}" />
      <column type="text" width="362" header="Name" items="{MagInventoryRowNames}"
              onclick="{SelectMagInventoryRow}" />
      <column type="text" width="50" align="right" header="Count" items="{MagInventoryRowCounts}"
              onclick="{SelectMagInventoryRow}" />
      <column type="text" width="90" header="Where" items="{MagInventoryRowPlaces}"
              onclick="{SelectMagInventoryRow}" />
    </list>

    <label x="4" y="374" w="632" h="80" text="{MagInventoryInfo}" color="theme:text|#FFE8DEC3"
           tooltip="The clicked item's full text." />
  </group>
</panel>
