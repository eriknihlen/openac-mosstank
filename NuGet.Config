<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Where the plugin contract package lands: CI downloads the
         `AcDream.Plugin.Abstractions` .nupkg from the OpenAC release into this
         folder before it restores, and a local build packs it there by hand
         (see README, "Building from source"). -->
    <add key="packages-local" value="./packages-local" />
  </packageSources>
</configuration>
